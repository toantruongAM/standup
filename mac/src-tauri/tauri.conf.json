{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StandUp",
  "version": "1.1.0",
  "identifier": "io.github.toantruongam.standup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
